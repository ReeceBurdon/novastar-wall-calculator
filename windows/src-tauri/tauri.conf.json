{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaStar Wall Calculator",
  "mainBinaryName": "NovaStar Wall Calculator",
  "version": "1.3.0",
  "identifier": "uk.co.reeceburdon.wallcalc",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Reece Burdon",
    "copyright": "Reece Burdon",
    "category": "Productivity",
    "shortDescription": "LED wall data and power routing, wiring plans and test cards for NovaStar processors.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ReeceBurdon/novastar-wall-calculator/releases/download/windows-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQkU4OThFQzRFMTMzRDIKUldUU00rSEVqb20rUUdWZFhRbnd6T3JZNzJkbjU1RzRVK2Z5WE1TVnIxQWNscjhMN3hoK3I0dlcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
